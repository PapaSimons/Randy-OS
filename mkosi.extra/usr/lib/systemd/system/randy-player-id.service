[Unit]
Description=Persistent per-installation Randy player identity
Before=squeezelite.service randy.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/lib/randy/player-id.py
StateDirectory=randy-device
StateDirectoryMode=0755
RemainAfterExit=yes
UMask=0022
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
