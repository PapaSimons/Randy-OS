[Unit]
Description=Lyrion Music Server (pinned Randy appliance build)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=squeezeboxserver
Group=squeezeboxserver
ExecStart=/usr/sbin/squeezeboxserver --prefsdir /var/lib/squeezeboxserver/prefs --cachedir /var/lib/squeezeboxserver/cache --logdir /var/log/squeezeboxserver --httpport 9000
StateDirectory=squeezeboxserver
StateDirectoryMode=0750
LogsDirectory=squeezeboxserver
LogsDirectoryMode=0750
Environment=HOME=/var/lib/squeezeboxserver
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
