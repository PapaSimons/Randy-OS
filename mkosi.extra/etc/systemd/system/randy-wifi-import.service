[Unit]
Description=Import optional Randy Wi-Fi provisioning file
Wants=NetworkManager.service run-randy\x2dconfig.mount
After=NetworkManager.service run-randy\x2dconfig.mount
ConditionPathIsMountPoint=/run/randy-config

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/lib/randy/wifi-import.py
# Also record systemd's actual result after failure/timeout or eventual stop.
ExecStopPost=/usr/bin/python3 /usr/lib/randy/wifi_diagnostics.py
TimeoutStopSec=15s
TimeoutStartSec=120s
Restart=no
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/NetworkManager/system-connections /run/randy-config

[Install]
WantedBy=multi-user.target
